@'
{
  "builds": [
    {
      "src": "frontend/notes-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "http://localhost:5000/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/notes-frontend/build/$1"
    }
  ]
}
'@ | Out-File -FilePath "vercel.json" -Encoding UTF8